# ─────────────────────────────────────────────────────────
# LACUNEX AI — Environment Variables Template for Docker
# Copy this to backend/.env and fill in your values
# ─────────────────────────────────────────────────────────

# ── Multi-Key Rotation (comma-separated) ────────────────

# Priority 1: Cerebras
CEREBRAS_API_KEYS=your_key_1,your_key_2,your_key_3

# Priority 2: Groq
GROQ_API_KEYS=your_key_1,your_key_2,your_key_3

# Priority 3: Gemini (up to 16 keys)
GEMINI_API_KEYS=your_key_1,your_key_2

# Priority 4: SambaNova
SAMBANOVA_API_KEYS=your_key_1,your_key_2,your_key_3

# Priority 5: OpenRouter
OPENROUTER_API_KEYS=your_key_1,your_key_2,your_key_3

# ── Legacy single-key fallbacks ─────────────────────────
CEREBRAS_API_KEY=your_main_cerebras_key
GROQ_API_KEY=your_main_groq_key
GOOGLE_AI_API_KEY=your_main_gemini_key
GOOGLE_AI_API_KEY_BACKUP=your_backup_gemini_key
OPENROUTER_API_KEY=your_main_openrouter_key

# ── App Config ──────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-secret

# Database URL is overridden by docker-compose.yml to point
# to the PostgreSQL container. This is only used for local dev.
DATABASE_URL=sqlite+aiosqlite:///./lacunex.db

# ── Image Fallback API Keys (optional) ──────────────────
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
PEXELS_KEY=
